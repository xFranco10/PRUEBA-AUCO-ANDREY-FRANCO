# Servidor
NODE_ENV=development
PORT=3001

# MongoDB (el de Compass en local)
MONGO_URI=mongodb://localhost:27017
MONGO_DB_NAME=auco_validations

# API pública externa (Nager.Date, sin API key)
EXTERNAL_API_BASE_URL=https://date.nager.at/api/v3
EXTERNAL_API_TIMEOUT_MS=5000
EXTERNAL_API_RETRIES=1

# DynamoDB Local (las credenciales son ficticias, DynamoDB Local no las valida)
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=local
AWS_SECRET_ACCESS_KEY=local
DYNAMODB_ENDPOINT=http://localhost:8000
DYNAMODB_TABLE=ValidationAudit
