{
  "name": "prueba-auco-andrey",
  "version": "1.0.0",
  "description": "Servicio de validaciones: Express + TypeScript + MongoDB + DynamoDB Local",
  "private": true,
  "type": "commonjs",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/server.js",
    "db:init": "tsx src/scripts/init-db.ts",
    "audit:list": "tsx src/scripts/audit-list.ts",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/xFranco10/PRUEBA-AUCO-ANDREY.git"
  },
  "license": "ISC",
  "bugs": {
    "url": "https://github.com/xFranco10/PRUEBA-AUCO-ANDREY/issues"
  },
  "homepage": "https://github.com/xFranco10/PRUEBA-AUCO-ANDREY#readme",
  "dependencies": {
    "@aws-sdk/client-dynamodb": "^3.1174.0",
    "@aws-sdk/lib-dynamodb": "^3.1174.0",
    "dotenv": "^18.0.10",
    "express": "^5.3.0",
    "mongoose": "^9.12.3",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/express": "^5.0.6",
    "@types/node": "^24.19.2",
    "eslint": "^10.15.0",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^17.14.0",
    "prettier": "^3.10.1",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.73.0"
  }
}
